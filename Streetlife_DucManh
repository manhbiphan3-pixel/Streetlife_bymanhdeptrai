local function SetupBackpackTab(parent)
    local listHolder = Instance.new("Frame", parent)
    listHolder.Size = UDim2.new(1, -6, 0, 0)
    listHolder.BackgroundTransparency = 1
    listHolder.ZIndex = MainFrame.ZIndex + 3

    local listLayout = Instance.new("UIListLayout", listHolder)
    listLayout.Padding = UDim.new(0, 6)

    local function GetFilteredItems(plr)
        local rawItems = {}
        if plr:FindFirstChild("Backpack") then
            for _, item in ipairs(plr.Backpack:GetChildren()) do
                if item:IsA("Tool") then table.insert(rawItems, item.Name) end
            end
        end
        if plr.Character then
            for _, item in ipairs(plr.Character:GetChildren()) do
                if item:IsA("Tool") then table.insert(rawItems, item.Name .. " (Cầm)") end
            end
        end

        local filtered = {}
        for _, name in ipairs(rawItems) do
            local lowerName = string.lower(name)
            local isJunk = string.find(lowerName, "pizza") or string.find(lowerName, "taco") or 
                           string.find(lowerName, "burger") or string.find(lowerName, "candy") or 
                           string.find(lowerName, "kẹo") or string.find(lowerName, "heal") or 
                           string.find(lowerName, "med") or string.find(lowerName, "phone") or 
                           string.find(lowerName, "điện thoại") or string.find(lowerName, "food") or 
                           string.find(lowerName, "drink") or string.find(lowerName, "water") or
                           string.find(lowerName, "mentos")

            local isMask = string.find(lowerName, "masked") or string.find(lowerName, "mask")
            local isGunShopAmmo = string.find(lowerName, "pistol ammo") or 
                                 string.find(lowerName, "smg ammo") or 
                                 string.find(lowerName, "rifle ammo") or 
                                 string.find(lowerName, "shotgun ammo") or 
                                 string.find(lowerName, "đạn súng ngắn") or 
                                 string.find(lowerName, "đạn trường")

            if not isJunk and not isMask and not isGunShopAmmo then
                table.insert(filtered, name)
            end
        end
        return filtered
    end

    local function RenderBackpackItems()
        for _, child in ipairs(listHolder:GetChildren()) do
            if not child:IsA("UIListLayout") then child:Destroy() end
        end

        local totalHeight = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local itemList = GetFilteredItems(plr)
                local hasNoItems = (#itemList == 0)

                local card = Instance.new("Frame", listHolder)
                card.Size = UDim2.new(1, 0, 0, 0)
                card.AutomaticSize = Enum.AutomaticSize.Y
                card.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                card.ZIndex = MainFrame.ZIndex + 3
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

                local nameLbl = Instance.new("TextLabel", card)
                nameLbl.Position = UDim2.new(0, 10, 0, 6)
                nameLbl.Size = UDim2.new(1, -20, 0, 18)
                nameLbl.Text = "👤 " .. plr.DisplayName
                nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.BackgroundTransparency = 1
                nameLbl.Font = Enum.Font.SourceSansBold
                nameLbl.TextSize = 13
                nameLbl.ZIndex = MainFrame.ZIndex + 4

                local itemsText = "🎒 Đồ: "
                if not hasNoItems then
                    itemsText = itemsText .. table.concat(itemList, ", ")
                else
                    itemsText = "🟢 Tay không (Không có đồ)"
                end

                local itemLbl = Instance.new("TextLabel", card)
                itemLbl.Position = UDim2.new(0, 10, 0, 26)
                itemLbl.Size = UDim2.new(1, -20, 0, 0)
                itemLbl.AutomaticSize = Enum.AutomaticSize.Y
                itemLbl.Text = itemsText
                itemLbl.TextColor3 = hasNoItems and Color3.fromRGB(150, 255, 150) or Color3.fromRGB(200, 200, 200)
                itemLbl.TextXAlignment = Enum.TextXAlignment.Left
                itemLbl.TextYAlignment = Enum.TextYAlignment.Top
                itemLbl.TextWrapped = true
                itemLbl.BackgroundTransparency = 1
                itemLbl.Font = Enum.Font.SourceSans
                itemLbl.TextSize = 11
                itemLbl.ZIndex = MainFrame.ZIndex + 4

                local approxLines = math.ceil(string.len(itemsText) / 45)
                local cardHeight = math.max(45, 26 + (approxLines * 15) + 8)
                card.Size = UDim2.new(1, 0, 0, cardHeight)

                totalHeight = totalHeight + cardHeight + 6
            end
        end

        listHolder.Size = UDim2.new(1, -6, 0, totalHeight)
        parent.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 70)
    end

    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            if tabShowItems.Visible then RenderBackpackItems() end
            task.wait(2)
        end
    end)

    RenderBackpackItems()
end
