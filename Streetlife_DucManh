local function TeleportWithScooter(targetCFrame, btnInfo)
    local btnObj = btnInfo.btn
    if btnInfo.isBusy then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if humanoid.SeatPart and humanoid.SeatPart.Parent then
        local vehicle = humanoid.SeatPart.Parent
        local safeCFrame = targetCFrame + Vector3.new(0, 1.5, 0)

        if vehicle:IsA("Model") then
            vehicle:PivotTo(safeCFrame)
            return
        elseif vehicle.Parent and vehicle.Parent:IsA("Model") then
            vehicle.Parent:PivotTo(safeCFrame)
            return
        end
    end

    btnInfo.isBusy = true
    btnObj.Text = (currentLang == "VN") and "  ❌ Bạn phải lên xe scooter mới được đi!" or "  ❌ Must ride a scooter to teleport!"
    btnObj.TextColor3 = Color3.fromRGB(200, 50, 50)
    
    task.wait(2)
    
    btnObj.Text = "  " .. ((currentLang == "VN") and btnInfo.nameVN or btnInfo.nameEN)
    btnObj.TextColor3 = Color3.fromRGB(230, 230, 230)
    btnInfo.isBusy = false
end

local function AddTeleportButton(parent, nameVN, nameEN, targetCFrame)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, -6, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.Text = "  " .. nameVN
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = MainFrame.ZIndex + 3

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local btnInfo = {btn = btn, nameVN = nameVN, nameEN = nameEN, isBusy = false}

    btn.MouseButton1Click:Connect(function()
        TeleportWithScooter(targetCFrame, btnInfo)
    end)
    
    parent.CanvasSize = UDim2.new(0, 0, 0, #parent:GetChildren() * 42)
    table.insert(teleButtons, btnInfo)
    return btn
end

