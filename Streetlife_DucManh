local function AddServerHopOption(parent)
    local visitedServers = {}
    if game.JobId ~= "" then table.insert(visitedServers, game.JobId) end

    local function HopToNewBigServer(statusLabel)
        local MIN_PLAYERS = 15
        local cursor = ""
        local foundServer = false
        if statusLabel then statusLabel.Text = (currentLang == "VN") and "Đang tìm server..." or "Searching server..." end

        task.spawn(function()
            repeat
                local Url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Desc&limit=100&cursor=%s", tostring(PlaceId), cursor)
                local success, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(Url)) end)

                if success and result and result.data then
                    for _, server in ipairs(result.data) do
                        local isVisited = false
                        for _, id in ipairs(visitedServers) do if server.id == id then isVisited = true; break end end
                        if not isVisited and server.playing >= MIN_PLAYERS and server.playing < server.maxPlayers then
                            foundServer = true
                            table.insert(visitedServers, server.id)
                            if statusLabel then statusLabel.Text = (currentLang == "VN") and "Đang kết nối..." or "Connecting..." end
                            TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                            break
                        end
                    end
                    cursor = result.nextPageCursor
                else
                    task.wait(1)
                end
            until foundServer or not cursor

            if not foundServer then
                visitedServers = {game.JobId}
                task.wait(1)
                HopToNewBigServer(statusLabel)
            end
        end)
    end

    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -6, 0, 45)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    frame.ZIndex = MainFrame.ZIndex + 3
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    
    local label = Instance.new("TextLabel", frame)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Size = UDim2.new(0, 200, 1, 0)
    label.Text = "Chuyển Server"
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
