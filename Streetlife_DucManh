-- Biến điều khiển xe bay
local flyStates = {Forward = false, Backward = false, Left = false, Right = false, Up = false, Down = false}

-- Logic Engine
local prevCamPitch, isShooting = nil, false

UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 then isShooting = true; prevCamPitch = nil end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then isShooting = false; prevCamPitch = nil end
end)

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera

    if Config.GunMods.NoRecoil and isShooting then
        local _, currentPitch, _ = cam.CFrame:ToEulerAnglesYXZ()
        if prevCamPitch ~= nil then
            local delta = currentPitch - prevCamPitch
            if delta < -0.0008 and mousemoverel then
                local comp = math.deg(delta * -1) * (cam.ViewportSize.Y / cam.FieldOfView) * 0.85
                mousemoverel(0, comp)
            end
        end
        prevCamPitch = currentPitch
    elseif not isShooting then
        prevCamPitch = nil
    end
end)

RunService.Stepped:Connect(function(_, dt)
    local char = LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local inCar = hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat")

    if inCar then
        local seat = hum.SeatPart
        local cam  = workspace.CurrentCamera

        if Config.Vehicles.CarSpeed and not Config.Vehicles.CarFly and seat.AssemblyLinearVelocity.Magnitude > 5 then
            seat.AssemblyLinearVelocity = seat.AssemblyLinearVelocity + (seat.CFrame.LookVector * (Config.Vehicles.CarSpeedAmount * dt))
        end

        if Config.Vehicles.CarFly then
            local vel = Vector3.new(0, 0, 0)
            local spd = Config.Vehicles.CarSpeedAmount

            if UIS:IsKeyDown(Enum.KeyCode.W) or seat.Throttle == 1 or flyStates.Forward then vel = vel + cam.CFrame.LookVector * spd end
            if UIS:IsKeyDown(Enum.KeyCode.S) or seat.Throttle == -1 or flyStates.Backward then vel = vel - cam.CFrame.LookVector * spd end
            if UIS:IsKeyDown(Enum.KeyCode.A) or seat.Steer == -1 or flyStates.Left then vel = vel - cam.CFrame.RightVector * spd end
            if UIS:IsKeyDown(Enum.KeyCode.D) or seat.Steer == 1 or flyStates.Right then vel = vel + cam.CFrame.RightVector * spd end
            
            if flyStates.Up then vel = vel + Vector3.new(0, spd, 0) end
            if flyStates.Down then vel = vel - Vector3.new(0, spd, 0) end

            seat.AssemblyLinearVelocity = vel
            seat.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end

    if Config.GunMods.FastReload and hum then
        for _, anim in pairs(hum:GetPlayingAnimationTracks()) do
            if string.find(string.lower(anim.Name), "reload") then 
                anim:AdjustSpeed(Config.GunMods.ReloadSpeed) 
            end
        end
    end
end)

-- Code Thể Lực Vô Hạn
local staminaKeywords = {"stamina", "energy", "sprint", "endurance", "run", "dash", "fatigue"}

RunService.Heartbeat:Connect(function()
    if not Config.Player.InfStamina then return end
    local char = LocalPlayer.Character
    if char then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local n = string.lower(v.Name)
                for _, kw in pairs(staminaKeywords) do
                    if string.find(n, kw) then v.Value = 100; break end
                end
            end
        end
        for name, val in pairs(char:GetAttributes()) do
            local n = string.lower(name)
            for _, kw in pairs(staminaKeywords) do
                if string.find(n, kw) and type(val) == "number" then char:SetAttribute(name, 100); break end
            end
        end
    end
    for _, v in pairs(LocalPlayer:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n = string.lower(v.Name)
            for _, kw in pairs(staminaKeywords) do
                if string.find(n, kw) then v.Value = 100; break end
            end
        end
    end
end)

